# Extrair resultados do modelo de Firth
forest_isc_atb <- data.frame(
  termo = names(coef(modelo_firth_isc_atb))[-1],
  OR = exp(coef(modelo_firth_isc_atb)[-1]),
  IC_inf = exp(modelo_firth_isc_atb$ci.lower[-1]),
  IC_sup = exp(modelo_firth_isc_atb$ci.upper[-1]),
  p = modelo_firth_isc_atb$prob[-1]
) %>%
  mutate(
    variavel = recode(
      termo,
      charlson = "Índice de Charlson",
      classificacao_isc_bin = "Profundidade da ISC",
      perfil_microbio_bin = "BGN CARBA-R",
      antibioticoterapia_bin = "Necessidade de ajuste da antibioticoterapia"
    ),
    OR_texto = ifelse(
      is.finite(OR),
      sprintf("%.2f", OR),
      "Não estimável"
    ),
    IC_texto = ifelse(
      is.finite(IC_inf) & is.finite(IC_sup),
      sprintf("%.2f–%.2f", IC_inf, IC_sup),
      "Não estimável"
    ),
    p_texto = ifelse(
      p < 0.001,
      "<0,001",
      sub("\\.", ",", sprintf("%.3f", p))
    )
  )

