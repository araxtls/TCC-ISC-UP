base_obito30 <- dados %>%
  transmute(
    # Desfecho
    obito_30_dias = case_when(
      str_to_lower(str_trim(as.character(obito_30_dias))) == "não" ~ 0,
      str_to_lower(str_trim(as.character(obito_30_dias))) == "sim" ~ 1,
      TRUE ~ NA_real_
    ),
    
    # Insuficiência hepática moderada/grave
    insuf_hepatica = case_when(
      as.character(ic_hepatica_moderada_grave) == "0" ~ 0,
      as.character(ic_hepatica_moderada_grave) == "3" ~ 1,
      TRUE ~ NA_real_
    ),
    
    # AVE
    AVE = case_when(
      as.character(ave) == "0" ~ 0,
      as.character(ave) == "1" ~ 1,
      TRUE ~ NA_real_
    ),
    
    # Histórico oncológico
    hx_oncologico_bin = case_when(
      is.na(hx_oncologico) ~ NA_real_,
      str_trim(as.character(hx_oncologico)) == "" ~ NA_real_,
      str_trim(as.character(hx_oncologico)) %in% c("-", "- ") ~ 0,
      TRUE ~ 1
    ),
    
    # Tumor metastático sólido
    tumor_metastatico = case_when(
      as.character(tumor_metastatico_solido) == "0" ~ 0,
      as.character(tumor_metastatico_solido) == "6" ~ 1,
      TRUE ~ NA_real_
    ),
    
    # Diabetes com complicação
    dm_com_complicacao_bin = case_when(
      as.character(dm_com_complicacao) == "0" ~ 0,
      as.character(dm_com_complicacao) == "2" ~ 1,
      TRUE ~ NA_real_
    )
  )
lapply(base_obito30, table, useNA = "ifany")

# Selecionar as variáveis do modelo
base_modelo_final <- base_obito30 %>%
  select(
    obito_30_dias,
    insuf_hepatica,
    AVE,
    hx_oncologico_bin,
    tumor_metastatico,
    dm_com_complicacao_bin
  ) %>%
  filter(complete.cases(.))

# Conferir tamanho da amostra e número de óbitos
cat("Total de pacientes:", nrow(base_modelo_final), "\n")
cat(
  "Óbitos em 30 dias:",
  sum(base_modelo_final$obito_30_dias == 1),
  "\n"
)

# Regressão logística multivariável
modelo_firth_obito30 <- logistf(
  obito_30_dias ~
    insuf_hepatica +
    AVE +
    hx_oncologico_bin +
    tumor_metastatico +
    dm_com_complicacao_bin,
  data = base_modelo_final
)
summary(modelo_firth_obito30)

# Extrair resultados do modelo de Firth
forest_prof <- data.frame(
  variavel = names(coef(modelo_firth_obito30))[-1],
  OR = exp(coef(modelo_firth_obito30)[-1]),
  IC_inf = exp(modelo_firth_obito30$ci.lower[-1]),
  IC_sup = exp(modelo_firth_obito30$ci.upper[-1]),
  p = modelo_firth_obito30$prob[-1]
) %>%
  mutate(
    variavel = recode(
      variavel,
      insuf_hepatica = "Insuficiência hepática moderada/grave",
      AVE = "Acidente vascular cerebral",
      hx_oncologico_bin = "Histórico oncológico",
      tumor_metastatico = "Tumor metastático sólido",
      dm_com_complicacao_bin = "Diabetes com complicações"
    )
  ) %>%
  arrange(match(
    variavel,
    c(
      "Tumor metastático sólido",
      "Diabetes com complicações",
      "Acidente vascular cerebral",
      "Histórico oncológico",
      "Insuficiência hepática moderada/grave"
    )
  ))

# Preparar a tabela com OR, IC95% e p
texto_tabela <- cbind(
  c("Variável", forest_prof$variavel),
  c("OR ajustado", ifelse(
    is.finite(forest_prof$OR),
    sprintf("%.2f", forest_prof$OR),
    "Não estimável"
  )),
  c("IC 95%", ifelse(
    is.finite(forest_prof$IC_inf) & is.finite(forest_prof$IC_sup),
    sprintf("%.2f–%.2f", forest_prof$IC_inf, forest_prof$IC_sup),
    "Não estimável"
  )),
  c("Valor de p", ifelse(
    forest_prof$p < 0.001,
    "<0,001",
    sprintf("%.3f", forest_prof$p)
  ))
)

