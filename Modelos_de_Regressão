dados_modelo3 <- dados %>%
  transmute(
    # Desfecho: óbito em 30 dias
    obito_30_dias_bin = case_when(
      str_to_lower(str_trim(as.character(obito_30_dias))) == "não" ~ 0,
      str_to_lower(str_trim(as.character(obito_30_dias))) == "sim" ~ 1,
      TRUE ~ NA_real_
    ),
    
    # Charlson: manter como variável numérica
    charlson = suppressWarnings(as.numeric(as.character(charlson))),
    
    # Classificação da ISC:
    # 1 = incisional profunda ou órgão/cavidade
    # 0 = incisional superficial
    classificacao_isc_bin = case_when(
      str_to_lower(str_squish(as.character(classificacao_isc))) %in%
        c("incisional profunda", "órgão/cavidade") ~ 1,
      str_to_lower(str_squish(as.character(classificacao_isc))) ==
        "incisional superficial" ~ 0,
      TRUE ~ NA_real_
    ),
    
    # Reoperação
    reoperacao_bin = case_when(
      str_to_lower(str_trim(as.character(reoperacao))) == "sim" ~ 1,
      str_to_lower(str_trim(as.character(reoperacao))) == "não" ~ 0,
      TRUE ~ NA_real_
    ),
    
    # Potencial de contaminação da ferida:
    # 1 = contaminada ou potencialmente contaminada
    # 0 = limpa
    contaminacao_bin = case_when(
      str_to_lower(str_trim(as.character(potencial_contaminacao_ferida))) %in%
        c("contaminada", "potencialmente contaminada") ~ 1,
      str_to_lower(str_trim(as.character(potencial_contaminacao_ferida))) ==
        "limpa" ~ 0,
      TRUE ~ NA_real_
    ),
    
    # Prótese
    protese_bin = case_when(
      str_to_lower(str_trim(as.character(protese))) == "sim" ~ 1,
      str_to_lower(str_trim(as.character(protese))) == "não" ~ 0,
      TRUE ~ NA_real_
    ),
    
    # Tempos de internação
    dias_internamento_pre_op =
      suppressWarnings(as.numeric(as.character(dias_internamento_pre_op))),
    
    dias_internamento_pos_isc =
      suppressWarnings(as.numeric(as.character(dias_internamento_pos_isc))),
    
    dias_cirurgia_ate_isc =
      suppressWarnings(as.numeric(as.character(dias_cirurgia_ate_isc))),
    
    # Perfil microbiológico:
    # 1 = BGN CARBA-R; 0 = demais categorias identificadas
    perfil_microbio_bin = case_when(
      str_to_lower(str_squish(as.character(perfil_microbio_binario))) ==
        "bgn carba r" ~ 1,
      !is.na(perfil_microbio_binario) &
        str_to_lower(str_squish(as.character(perfil_microbio_binario))) !=
        "não identificado" ~ 0,
      TRUE ~ NA_real_
    ),
    
    # Antibioticoterapia:
    # 1 = sem correção, com necessidade de escalonar
    # 0 = demais categorias válidas, exceto sem dados de antibiótico
    antibioticoterapia_bin = case_when(
      str_to_lower(str_squish(as.character(`antibioticoterapia_binário`))) ==
        "sem correção, necessidade de escalonar" ~ 1,
      !is.na(`antibioticoterapia_binário`) &
        str_to_lower(str_squish(as.character(`antibioticoterapia_binário`))) !=
        "sem dados antibiótico" ~ 0,
      TRUE ~ NA_real_
    )
  )

