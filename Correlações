# 2. Remover valores que representam ausência de informação
limpar_variavel <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c("", "-", "NA", "N/A")] <- NA
  x
}

# 3. Função para testar associação entre duas variáveis
testar_associacao <- function(alvo, variavel, dados) {
  
  df <- tibble(
    y = limpar_variavel(dados[[alvo]]),
    x_original = dados[[variavel]]
  ) %>%
    mutate(
      x = limpar_variavel(x_original)
    ) %>%
    filter(!is.na(y), !is.na(x))
  
  if (nrow(df) < 10 ||
      n_distinct(df$y) < 2 ||
      n_distinct(df$x) < 2) {
    return(NULL)
  }
  
  # Se a variável explicativa for numérica
  x_num <- suppressWarnings(as.numeric(df$x))
  
  eh_numerica <- !all(is.na(x_num)) &&
    n_distinct(x_num[!is.na(x_num)]) >= 5 &&
    all(!is.na(x_num) | is.na(df$x))
  
  if (eh_numerica) {
    
    df$x_num <- x_num
    
    resultado <- tryCatch(
      kruskal.test(x_num ~ factor(y), data = df),
      error = function(e) NULL
    )
    
    if (is.null(resultado)) return(NULL)
    
    teste <- "Kruskal-Wallis"
    p <- resultado$p.value
    
  } else {
    
    tab <- table(df$y, df$x)
    
    if (nrow(tab) < 2 || ncol(tab) < 2) return(NULL)
    
    resultado <- tryCatch(
      chisq.test(tab, simulate.p.value = TRUE, B = 10000),
      error = function(e) NULL
    )
    
    if (is.null(resultado)) return(NULL)
    
    teste <- "Qui-quadrado com Monte Carlo"
    p <- resultado$p.value
  }
  
  tibble(
    variavel_alvo = alvo,
    variavel_testada = variavel,
    n = nrow(df),
    teste = teste,
    p_valor = p
  )
}

# 4. Executar os testes
resultados <- map_dfr(alvos, function(alvo) {
  
  map_dfr(variaveis_teste, function(variavel) {
    
    if (variavel == alvo) return(NULL)
    
    testar_associacao(
      alvo = alvo,
      variavel = variavel,
      dados = dados
    )
  })
})

# 5. Corrigir p-valores por FDR separadamente para cada alvo
resultados <- resultados %>%
  group_by(variavel_alvo) %>%
  mutate(
    p_ajustado_FDR = p.adjust(p_valor, method = "BH")
  ) %>%
  ungroup() %>%
  arrange(variavel_alvo, p_ajustado_FDR)

# 6. Exibir tabela compacta
resultados %>%
  mutate(
    p_valor = signif(p_valor, 3),
    p_ajustado_FDR = signif(p_ajustado_FDR, 3)
  ) %>%
  print(n = Inf)

# Criar tabela final com indicação de associação estatística
tabela_final <- resultados %>%
  mutate(
    associacao_estatistica = if_else(
      p_ajustado_FDR < 0.05,
      "Sim",
      "Não"
    )
  ) %>%
  arrange(variavel_alvo, p_ajustado_FDR)

# Exportar CSV para a Área de Trabalho
