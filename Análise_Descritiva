correlacionar_todas <- function(
    dados,
    excluir = c(
      "id", "at", "nome",
      "data_nascimento",
      "data_internamento_pre_op",
      "data_cirurgia",
      "data_isc",
      "data_desfecho"
    ),
    minimo_n = 10
) {
  
  variaveis <- setdiff(names(dados), excluir)
  
  elegiveis <- variaveis[
    vapply(dados[variaveis], function(x) {
      x <- x[!is.na(x)]
      length(x) >= minimo_n &&
        length(unique(x)) > 1
    }, logical(1))
  ]
  
  tipo <- function(x) {
    
    if (inherits(x, c("Date", "POSIXct", "POSIXlt"))) {
      return("excluir")
    }
    
    if (is.numeric(x) || is.integer(x)) {
      return("quantitativa")
    }
    
    if (is.logical(x) || is.factor(x) || is.character(x)) {
      return("qualitativa")
    }
    
    "excluir"
  }
  
  tipos <- vapply(
    dados[elegiveis],
    tipo,
    character(1)
  )
  
  elegiveis <- elegiveis[tipos != "excluir"]
  
  pares <- combn(elegiveis, 2, simplify = FALSE)
  
  resultados <- lapply(pares, function(par) {
    
    v1 <- par[1]
    v2 <- par[2]
    
    x <- dados[[v1]]
    y <- dados[[v2]]
    
    validos <- complete.cases(x, y)
    x <- x[validos]
    y <- y[validos]
    
    resultado <- tibble(
      variavel_1 = v1,
      variavel_2 = v2,
      tipo_1 = tipo(dados[[v1]]),
      tipo_2 = tipo(dados[[v2]]),
      n = length(x),
      teste = NA_character_,
      estimativa = NA_real_,
      p_valor = NA_real_
    )
    
    if (length(x) < minimo_n ||
        length(unique(x)) < 2 ||
        length(unique(y)) < 2) {
      resultado$teste <- "Não calculado"
      return(resultado)
    }
    
    tryCatch({
      
      if (is.numeric(x) && is.numeric(y)) {
        
        teste <- cor.test(
          x, y,
          method = "spearman",
          exact = FALSE
        )
        
        resultado$teste <- "Spearman"
        resultado$estimativa <- unname(teste$estimate)
        resultado$p_valor <- teste$p.value
        
      } else if (
        (is.numeric(x) && !is.numeric(y)) ||
        (!is.numeric(x) && is.numeric(y))
      ) {
        
        if (!is.numeric(x)) {
          temp <- x
          x <- y
          y <- temp
        }
        
        grupo <- as.factor(y)
        
        if (nlevels(grupo) == 2) {
          teste <- wilcox.test(
            x ~ grupo,
            exact = FALSE
          )
          resultado$teste <- "Mann-Whitney"
        } else {
          teste <- kruskal.test(x ~ grupo)
          resultado$teste <- "Kruskal-Wallis"
        }
        
        resultado$p_valor <- teste$p.value
        
      } else {
        
        tab <- table(x, y)
        
        if (nrow(tab) < 2 || ncol(tab) < 2) {
          resultado$teste <- "Não calculado"
          return(resultado)
        }
        
        esperado <- suppressWarnings(
          chisq.test(tab, correct = FALSE)$expected
        )
        
        if (all(dim(tab) == c(2, 2)) &&
            any(esperado < 5)) {
          
          teste <- fisher.test(tab)
          resultado$teste <- "Fisher"
          
        } else if (any(esperado < 5)) {
          
          teste <- chisq.test(
            tab,
            simulate.p.value = TRUE,
            B = 20000
          )
          resultado$teste <- "Qui-quadrado simulado"
          
        } else {
          
          teste <- chisq.test(tab, correct = FALSE)
          resultado$teste <- "Qui-quadrado"
        }
        
        resultado$p_valor <- teste$p.value
      }
      
      resultado
      
    }, error = function(e) {
      resultado$teste <- "Erro no teste"
      resultado
    })
  })
  
  bind_rows(resultados) %>%
    mutate(
      p_ajustado_BH = p.adjust(
        p_valor,
        method = "BH"
      )
    ) %>%
    arrange(p_ajustado_BH)
}

resultados_todas_variaveis <- correlacionar_todas(dados)

print(resultados_todas_variaveis, n = Inf, width = Inf)

