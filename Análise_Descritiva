limpar_categoria <- function(x) {
  x <- str_squish(as.character(x))
  x[x %in% c("", "-")] <- NA_character_
  x
}

# Função para gráfico de barras horizontais
grafico_barras <- function(data, variavel,
                           titulo, eixo_x,
                           top_n = Inf) {
  
  tabela <- data %>%
    transmute(categoria = limpar_categoria({{ variavel }})) %>%
    filter(!is.na(categoria)) %>%
    count(categoria, name = "n") %>%
    arrange(desc(n))
  
  if (is.finite(top_n)) {
    tabela <- tabela %>% slice_head(n = top_n)
  }
  
  ggplot(
    tabela,
    aes(x = n, y = fct_reorder(categoria, n))
  ) +
    geom_col(fill = "lightskyblue3", color = "black",
             width = 0.75) +
    geom_text(aes(label = n), hjust = -0.2, size = 3.5) +
    scale_x_continuous(expand = expansion(mult = c(0, 0.15))) +
    labs(
      title = titulo,
      x = eixo_x,
      y = NULL
    ) +
    theme_minimal(base_size = 12) +
    theme(
      plot.title = element_text(face = "bold"),
      panel.grid.major.y = element_blank()
    )
}

