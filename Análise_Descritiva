auditar_variavel <- function(nome_variavel) { ##verificando variaveis qualitativas
  
  x <- dados[[nome_variavel]]
  
  cat("\n====================================\n")
  cat("VARIÁVEL:", nome_variavel, "\n")
  cat("====================================\n")
  
  cat("Classe:", class(x), "\n")
  cat("Total de pacientes:", length(x), "\n")
  cat("Valores ausentes (NA):", sum(is.na(x)), "\n")
  cat("Valores preenchidos:", sum(!is.na(x)), "\n\n")
  
  frequencias <- tibble(
    categoria = as.character(x)
  ) %>%
    count(categoria, name = "frequencia", .drop = TRUE) %>%
    mutate(
      porcentagem_validos =
        100 * frequencia / sum(frequencia[categoria != ""])
    ) %>%
    arrange(desc(frequencia))
  
  print(frequencias, n = Inf, width = Inf)
}

frequencias_qualitativas <- dados %>%
  select(all_of(variaveis_qualitativas)) %>%
  mutate(across(everything(), as.character)) %>%
  pivot_longer(
    cols = everything(),
    names_to = "variavel",
    values_to = "categoria_original"
  ) %>%
  mutate(
    categoria_original = str_trim(categoria_original),
    ausente = is.na(categoria_original) |
      categoria_original %in% c("", "-"),
    categoria = if_else(
      ausente,
      "Sem informação",
      categoria_original
    )
  ) %>%
  group_by(variavel) %>%
  mutate(
    n_total = n(),
    n_validos = sum(!ausente)
  ) %>%
  group_by(variavel, categoria, n_total, n_validos) %>%
  summarise(
    n = n(),
    .groups = "drop"
  ) %>%
  mutate(
    porcentagem_total = 100 * n / n_total,
    porcentagem_validos = if_else(
      categoria == "Sem informação",
      NA_real_,
      100 * n / n_validos
    )
  ) %>%
  select(
    variavel,
    categoria,
    n,
    porcentagem_validos,
    porcentagem_total
  ) %>%
  arrange(variavel, desc(n))

