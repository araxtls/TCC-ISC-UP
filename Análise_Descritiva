# 2. Função para comparar o Charlson entre as categorias
# das variáveis qualitativas

analisar_charlson <- function(var) {
  
  # Selecionar as duas variáveis e excluir dados ausentes
  base <- dados %>%
    transmute(
      charlson = suppressWarnings(
        as.numeric(as.character(charlson))
      ),
      grupo = as.factor(.data[[var]])
    ) %>%
    filter(!is.na(charlson), !is.na(grupo)) %>%
    droplevels()
  
  # Número de categorias observadas
  n_grupos <- nlevels(base$grupo)
  
  # Não realizar teste se houver menos de duas categorias
  if (n_grupos < 2) {
    return(tibble(
      variavel = var,
      n = nrow(base),
      teste = NA_character_,
      estatistica = NA_real_,
      p_valor = NA_real_,
      resultado = "Menos de duas categorias válidas"
    ))
  }
  
  # Estatísticas descritivas por categoria
  resumo <- base %>%
    group_by(grupo) %>%
    summarise(
      n = n(),
      mediana = median(charlson),
      Q1 = quantile(charlson, 0.25),
      Q3 = quantile(charlson, 0.75),
      .groups = "drop"
    )
  
  # Teste de Kruskal-Wallis:
  # comparação do escore entre 2 ou mais grupos
  teste <- kruskal.test(charlson ~ grupo, data = base)
  
  tibble(
    variavel = var,
    n = nrow(base),
    teste = "Kruskal-Wallis",
    estatistica = unname(teste$statistic),
    p_valor = teste$p.value,
    resultado = paste(
      resumo$grupo,
      paste0(
        "n=", resumo$n,
        "; mediana=", resumo$mediana,
        "; Q1=", resumo$Q1,
        "; Q3=", resumo$Q3
      ),
      collapse = " | "
    )
  )
}


